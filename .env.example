DATABASE_URL=sqlite:///./data/submissions.sqlite3
SHINJUKU_ENV=development
SHINJUKU_AUTH_MODE=development-key
SHINJUKU_ADMIN_KEY=replace-with-a-long-random-development-key
SHINJUKU_SESSION_SECRET=replace-with-at-least-32-random-characters
SHINJUKU_CLIENT_HASH_SALT=replace-with-a-separate-random-value
SHINJUKU_CORS_ORIGINS=http://localhost:3000
SHINJUKU_DATA_DIR=../data/processed
